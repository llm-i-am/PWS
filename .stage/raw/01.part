<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="color-scheme" content="light dark"><meta name="theme-color" media="(prefers-color-scheme:light)" content="#edf5fc"><meta name="theme-color" media="(prefers-color-scheme:dark)" content="#07111c"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="format-detection" content="telephone=no"><title>Local Weather</title><!-- Version 2 --><style>
:root{color-scheme:light dark;--p:#edf5fc;--p2:#fbfdff;--i:#0a1119;--m:rgba(10,17,25,.58);--f:rgba(10,17,25,.39);--line:rgba(20,40,60,.10);--card:rgba(255,255,255,.76);--g:rgba(248,252,255,.48);--gs:rgba(248,252,255,.68);--edge:rgba(255,255,255,.72);--a:#007aff;--ok:#248a3d;--warn:#9a6400;--bad:#c9342f;--st:env(safe-area-inset-top,0px);--sr:env(safe-area-inset-right,0px);--sb:env(safe-area-inset-bottom,0px);--sl:env(safe-area-inset-left,0px)}@media(prefers-color-scheme:dark){:root{--p:#07111c;--p2:#0b1724;--i:#f5f9fc;--m:rgba(245,249,252,.64);--f:rgba(245,249,252,.40);--line:rgba(255,255,255,.10);--card:rgba(18,31,44,.76);--g:rgba(31,48,65,.46);--gs:rgba(35,53,71,.68);--edge:rgba(255,255,255,.18);--a:#0a84ff;--ok:#30d158;--warn:#ffb340;--bad:#ff6961}}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--p);-webkit-text-size-adjust:100%}body{min-height:100svh;color:var(--i);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text",system-ui,sans-serif;-webkit-font-smoothing:antialiased;background:radial-gradient(650px 380px at -12% -5%,rgba(66,190,255,.23),transparent 62%),radial-gradient(540px 430px at 112% 32%,rgba(80,225,190,.14),transparent 66%),linear-gradient(180deg,var(--p2),var(--p));overscroll-behavior-y:none}button,input{font:inherit;-webkit-tap-highlight-color:transparent}button{touch-action:manipulation}.app{width:min(100%,480px);min-height:100svh;margin:auto;padding:calc(12px + var(--st)) max(14px,calc(14px + var(--sr))) calc(10px + var(--sb)) max(14px,calc(14px + var(--sl)));display:flex;flex-direction:column;gap:10px}.top{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 2px}.top h1{margin:0;font-size:32px;line-height:1;letter-spacing:-.045em;font-weight:790}.status{margin-top:8px;display:flex;align-items:center;gap:7px;color:var(--m);font-size:12.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.dot{width:7px;height:7px;border-radius:50%;background:var(--f);box-shadow:0 0 0 4px rgba(127,127,127,.08)}.dot.live{background:var(--ok)}.dot.warn{background:var(--warn)}.dot.bad{background:var(--bad)}.glass{background:linear-gradient(145deg,rgba(255,255,255,.16),transparent 42%),var(--g);border:1px solid var(--edge);box-shadow:0 18px 52px rgba(24,54,82,.17),inset 0 1px 0 rgba(255,255,255,.45);-webkit-backdrop-filter:blur(24px) saturate(175%);backdrop-filter:blur(24px) saturate(175%)}.tools{display:flex;padding:3px;border-radius:999px}.icon{width:46px;height:46px;border:0;border-radius:50%;padding:0;color:var(--i);background:transparent;display:grid;place-items:center}.icon:active{transform:scale(.91);background:rgba(127,127,127,.12)}.icon svg{width:21px;height:21px}.icon.busy svg{animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}main{flex:1;min-height:0;display:flex;align-items:center}.panel{width:100%;border-radius:34px;overflow:hidden;background:var(--card);border:1px solid var(--line);box-shadow:0 18px 55px rgba(30,66,95,.10),inset 0 1px 0 rgba(255,255,255,.18);-webkit-backdrop-filter:blur(16px) saturate(125%);backdrop-filter:blur(16px) saturate(125%)}.grid{display:grid;grid-template-columns:1fr 1fr}.metric{position:relative;min-height:127px;padding:16px;border:0;color:inherit;background:transparent;text-align:left;overflow:hidden}.metric:nth-child(odd):not(.wide){border-right:1px solid var(--line)}.metric:nth-child(-n+4){border-bottom:1px solid var(--line)}.metric:active{background:color-mix(in srgb,var(--a) 6%,transparent);transform:scale(.985)}.wide{grid-column:1/-1;min-height:90px;display:flex;align-items:center;justify-content:space-between;gap:18px}.label{font-size:14px;font-weight:720}.count{margin-left:4px;color:var(--m);font-size:12px;font-weight:650}.val{margin-top:13px;font-size:clamp(27px,8vw,33px);line-height:1;font-weight:730;letter-spacing:-.045em;font-variant-numeric:tabular-nums;white-space:nowrap}.wide .val{margin:0;text-align:right}.suffix{margin-left:5px;color:var(--m);font-size:14px;font-weight:700}.range{margin-top:7px;min-height:15px;color:var(--m);font-size:11.5px;font-weight:590;font-variant-numeric:tabular-nums;white-space:nowrap}.wide .right{text-align:right}.loading .val,.loading .range{color:transparent;border-radius:999px;background:linear-gradient(100deg,rgba(127,127,127,.09) 20%,rgba(255,255,255,.32) 42%,rgba(127,127,127,.09) 64%);background-size:220% 100%;animation:sh 1.2s infinite}.loading .val{width:85px;height:30px}.loading .range{width:68px;height:12px}@keyframes sh{to{background-position:-120% 0}}footer{min-height:24px;display:flex;justify-content:center;align-items:center;color:var(--f);font-size:10.5px;font-weight:580}footer a{color:inherit;text-decoration:none;font-weight:700}dialog{padding:0;border:0;background:transparent;color:var(--i);overflow:visible}dialog::backdrop{background:rgba(4,12,20,.22);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}.dlg{width:min(calc(100% - 24px),420px);margin:auto}.surf{position:relative;max-height:calc(100svh - var(--st) - var(--sb) - 24px);overflow:auto;border-radius:32px;background:linear-gradient(145deg,rgba(255,255,255,.18),transparent 40%),var(--gs);border:1px solid var(--edge);box-shadow:0 28px 78px rgba(8,26,44,.30),inset 0 1px 0 rgba(255,255,255,.34);-webkit-backdrop-filter:blur(34px) saturate(185%);backdrop-filter:blur(34px) saturate(185%);padding:14px}.head{display:flex;justify-cont
ent:space-between;gap:10px;align-items:flex-start;padding:4px 2px 11px 5px}.head h2{margin:0;font-size:23px;line-height:1.05;letter-spacing:-.035em}.sum{margin-top:6px;color:var(--m);font-size:12px;font-weight:620}.acts{display:flex;gap:4px;position:relative}.dicon{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);color:var(--i);background:rgba(127,127,127,.075);display:grid;place-items:center}.dicon svg{width:19px;height:19px}.dicon:active{transform:scale(.9)}.sortmenu{position:absolute;right:48px;top:48px;z-index:4;width:180px;padding:6px;border-radius:20px;display:none}.sortmenu.show{display:block}.sortmenu button{width:100%;min-height:44px;border:0;border-radius:14px;padding:0 10px;display:flex;align-items:center;justify-content:space-between;color:var(--i);background:transparent;text-align:left;font-size:13px;font-weight:650}.sortmenu button:active{background:rgba(127,127,127,.12)}.list{border:1px solid var(--line);border-radius:22px;overflow:hidden;background:rgba(127,127,127,.055)}.row{min-height:57px;padding:9px 13px;display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid var(--line)}.row:last-child{border:0}.name{font-size:13.5px;font-weight:690;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sub,.extra{margin-top:3px;color:var(--f);font-size:10.5px;font-weight:600}.rval{text-align:right;font-size:15.5px;font-weight:745;font-variant-numeric:tabular-nums;white-space:nowrap}.unavail{padding:10px 8px 0;color:var(--f);font-size:10.5px;line-height:1.35}.setup p{margin:0 5px 13px;color:var(--m);font-size:12.5px;line-height:1.45}.field{display:block;margin:9px 0}.field span{display:block;margin:0 0 5px 5px;color:var(--m);font-size:11px;font-weight:700}.field input{width:100%;height:48px;border-radius:16px;border:1px solid var(--line);padding:0 13px;color:var(--i);background:rgba(127,127,127,.08);font-size:16px;outline:none}.primary{width:100%;height:48px;margin-top:7px;border:0;border-radius:16px;color:white;background:var(--a);font-weight:750}.clear{width:100%;height:44px;margin-top:6px;border:0;border-radius:15px;color:var(--bad);background:transparent;font-weight:650}.toast{position:fixed;z-index:10;left:14px;right:14px;bottom:calc(14px + var(--sb));max-width:440px;margin:auto;padding:12px 15px;border-radius:19px;color:var(--i);font-size:12px;font-weight:650;opacity:0;transform:translateY(12px);pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:none}@media(max-height:690px){.app{gap:6px}.top{min-height:66px}.metric{min-height:111px;padding:13px 15px}.wide{min-height:80px}.val{margin-top:10px}footer{min-height:18px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}@media(prefers-reduced-transparency:reduce){:root{--card:#f8fbff;--g:#f4f8fc;--gs:#f4f8fc}.glass,.panel,.surf,dialog::backdrop{-webkit-backdrop-filter:none!important;backdrop-filter:none!important}}@media(prefers-color-scheme:dark) and (prefers-reduced-transparency:reduce){:root{--card:#142231;--g:#172838;--gs:#1a2b3b}}@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.glass,.surf{background:var(--gs)}.panel{background:var(--card)}}
</style></head><body><div class="app"><header class="top"><div><h1>Local Weather</h1><div class="status"><i id="dot" class="dot"></i><span id="status">Loading local stations…</span></div></div><div class="tools glass"><button id="refresh" class="icon" aria-label="Refresh weather"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg></button><button id="settings" class="icon" aria-label="Xweather settings"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.1A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.1A1.7 1.7 0 0 0 15.4 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.1.37.31.7.6 1 .3.26.69.4 1.1.4h.1v4h-.1c-.41 0-.8.14-1.1.4-.29.3-.5.63-.6 1z"/></svg></button></div></header><main><section class="panel"><div id="grid" class="grid"></div></section></main><footer>PWSweather stations · <a href="https://www.xweather.com/" target="_blank" rel="noopener">powered by Vaisala Xweather</a></footer></div>
<dialog id="detail" class="dlg"><div class="surf"><div class="head"><div><h2 id="dtitle">Metric</h2><div id="dsum" class="sum"></div></div><div class="acts"><button id="sort" class="dicon" aria-label="Sort stations"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h12M8 12h9M8 18h6M4 5v14m0 0-2-2m2 2 2-2"/></svg></button><div id="sortmenu" class="sortmenu glass"><button data-sort="asc">Low → High <b></b></button><button data-sort="desc">High → Low <b></b></button><button data-sort="alpha">Station A → Z <b></b></button></div><button id="close" class="dicon" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div></div><div id="rows" class="list"></div><div id="unavail" class="unavail"></div></div></dialog>
<dialog id="setup" class="dlg setup"><form id="form" class="surf" method="dialog"><div class="head"><div><h2>Xweather Access</h2><div class="sum">One-time setup on this device</div></div><button id="setupClose" type="button" class="dicon" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><p